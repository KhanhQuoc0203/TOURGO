    h2 { color: #2980b9; border-left: 5px solid #2980b9; padding-left: 10px; margin-top: 25px; }
    h3 { background-color: #f8f9fa; padding: 5px; font-size: 14px; border-bottom: 1px solid #ddd; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 20px; table-layout: fixed; }
    th, td { border: 1px solid #bdc3c7; padding: 8px; text-align: left; vertical-align: top; font-size: 11px; }
    th { background-color: #f2f2f2; }
    pre { white-space: pre-wrap; margin: 0; font-family: 'Courier New', monospace; font-size: 11px; }
    .del-block { background-color: #fce4e4; color: #c0392b; border-left: 4px solid #c0392b; padding: 5px; margin-bottom: 5px; }
    .add-block { background-color: #e8f5e9; color: #2e7d32; border-left: 4px solid #2e7d32; padding: 5px; }
</style>
</head>
